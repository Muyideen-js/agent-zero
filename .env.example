# Filled in automatically by scripts/setup-testnet.sh (written to .env.local).

# Public: safe to expose to the browser
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_CONTRACT_ID=zero.yourname.testnet
NEXT_PUBLIC_NEAR_COMPANY_ID=insightforge

# Server only: the operator account the app signs payout requests with.
# This key can request payouts but cannot change policy, pause or withdraw.
NEAR_OPERATOR_ACCOUNT_ID=ops.yourname.testnet
NEAR_OPERATOR_PRIVATE_KEY=ed25519:...

# Optional: custom RPC
# NEAR_RPC_URL=https://test.rpc.fastnear.com

# AI workforce: any OpenAI-compatible endpoint. Defaults to NEAR AI Cloud.
# Get a key at https://cloud.near.ai
AI_API_KEY=
# AI_BASE_URL=https://cloud-api.near.ai/v1
# AI_MODEL=deepseek-ai/DeepSeek-V3.1
